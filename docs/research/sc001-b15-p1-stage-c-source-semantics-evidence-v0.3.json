    "OKX_FIXED_FEE": "fee",
    "OKX_PERCENTAGE_FEE": "burningFeeRate",
    "OKX_FEE_CURRENCY": "feeCcy",
    "OKX_MIN_WITHDRAW": "minWd",
    "OKX_MIN_DEPOSIT": "minDep",
    "OKX_MAX_WITHDRAW": "maxWd",
    "OKX_PRECISION": "wdTickSz",
    "OKX_CONFIRMATION": ["minDepArrivalConfirm","minWdUnlockConfirm"]
  },
  "fail_closed_statuses": [
