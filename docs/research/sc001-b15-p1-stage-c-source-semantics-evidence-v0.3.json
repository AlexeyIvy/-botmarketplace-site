    "BYBIT_WITHDRAW_STATE": "chainWithdraw",
    "BYBIT_FIXED_FEE": "withdrawFee",
    "BYBIT_PERCENTAGE_FEE": "withdrawPercentageFee",
    "BYBIT_MIN_WITHDRAW": "withdrawMin",
    "BYBIT_MIN_DEPOSIT": "depositMin",
    "BYBIT_MAX_WITHDRAW": "withdrawMax",
