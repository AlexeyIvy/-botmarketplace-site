[Unit]
Description=BotMarketplace Research Reader MCP
Documentation=file:/opt/botmarket-research/app/reader_server.py
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=botmarket-mcp
Group=botmarket-reader
WorkingDirectory=/opt/botmarket-research/app
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/botmarket-research/venv/bin/python /opt/botmarket-research/app/reader_server.py
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=15

# Filesystem / privilege hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# Process / syscall hardening
SystemCallArchitectures=native
RestrictNamespaces=yes
ProtectProc=invisible
ProcSubset=pid

# Reader is intentionally read-only.
ReadOnlyPaths=/opt/botmarket-research
ReadOnlyPaths=/etc/botmarket-research
ReadOnlyPaths=/var/lib/botmarket-research/published
InaccessiblePaths=/var/lib/botmarket-research/runs
InaccessiblePaths=/var/lib/botmarket-research/control
InaccessiblePaths=/var/log/botmarket-research

# Network: service shares host loopback, but may only bind/connect localhost.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Resource limits
MemoryMax=512M
CPUQuota=50%
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
