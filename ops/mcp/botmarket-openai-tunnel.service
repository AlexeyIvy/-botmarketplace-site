[Unit]
Description=BotMarketplace OpenAI Secure MCP Tunnel
Documentation=https://github.com/openai/tunnel-client
After=network-online.target botmarket-reader-mcp.service
Wants=network-online.target
Requires=botmarket-reader-mcp.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=botmarket-tunnel
Group=botmarket-tunnel
WorkingDirectory=/var/lib/botmarket-tunnel
RuntimeDirectory=botmarket-tunnel
RuntimeDirectoryMode=0750
Environment=HOME=/var/lib/botmarket-tunnel
ExecStart=/opt/botmarket-research/bin/tunnel-client-runtime run --profile-file /etc/botmarket-research/tunnel/runtime.yaml
ExecStartPost=/opt/botmarket-research/bin/tunnel-readiness
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=20

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
SystemCallArchitectures=native
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

ReadOnlyPaths=/opt/botmarket-research/bin
ReadOnlyPaths=/etc/botmarket-research/tunnel
InaccessiblePaths=/home/botmarket
InaccessiblePaths=/var/lib/botmarket-research
InaccessiblePaths=/var/log/botmarket-research

MemoryMax=256M
CPUQuota=25%
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
